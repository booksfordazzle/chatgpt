# Server-side only. Keep real values out of public/, Git and chat.
GOOGLE_APPS_SCRIPT_URL=
WAITLIST_SHARED_SECRET=
SITE_URL=https://primalcore.gr
# Production SMTP. Set the real mailbox password only in Vercel's sensitive settings.
SMTP_HOST=smtp-gr.securemail.pro
SMTP_PORT=465
SMTP_USER=hello@primalcore.gr
SMTP_PASSWORD=

# Skin Profile draft: enable only after content/privacy review and controlled checks.
# Optional emergency off switch; configured SMTP enables result delivery by default.
# SKIN_PROFILE_EMAIL_ENABLED=false
SKIN_PROFILE_ANALYTICS_ENABLED=false
# Optional separate aggregate research/funnel storage; never exposed to browsers.
SKIN_PROFILE_SUPABASE_URL=
SKIN_PROFILE_SUPABASE_SERVICE_ROLE_KEY=
# Enable only after deploying Code.gs + SkinResearch.gs and verifying the target Sheet.
# Uses GOOGLE_APPS_SCRIPT_URL and WAITLIST_SHARED_SECRET above; no Supabase needed for V2.
SKIN_PROFILE_RESEARCH_V2_ENABLED=false

# Dedicated survey Apps Script project (keeps waitlist integration unchanged).
SKIN_PROFILE_RESEARCH_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyupzOZIwT7Y4EOOhYat6zdAk0iX1I8x_OhCVhSTI9RHGorVttTL3yv_qugZJYUCbC9pA/exec
SKIN_PROFILE_RESEARCH_SECRET=

# Optional public analytics identifiers (set at build time; never put API secrets here).
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
